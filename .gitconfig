[core]
	editor = hx

[user]
	name = Rasmus Mecklenburg
	email = 42248344+rmburg@users.noreply.github.com
	signingkey = FA515CAF1A69AC51

[credential]
	helper = store

[merge]
	conflictstyle = diff3

[fetch]
	parallel = 0

[diff]
	external = difft --color=always
	tool = difftastic

[difftool]
	prompt = false

[difftool "difftastic"]
	cmd = difft --color=always "$LOCAL" "$REMOTE"

[pager]
	difftool = true

[commit]
	gpgsign = true

[init]
	defaultBranch = main

[filter "lfs"]
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process

[pull]
	rebase = true

[branch]
	sort = -committerdate

[push]
	autoSetupRemote = true

[rebase]
	autoSquash = true

[alias]
	autosquash = !GIT_SEQUENCE_EDITOR=true git rebase -i --autosquash
	fixup = !git log -n 20 --pretty=format:'%h %s' --no-merges | fzf | cut -c -7 | xargs -o git commit --fixup

[includeIf "hasconfig:remote.*.url:git@collaborating.tuhh.de:*/**"]
	path = ~/.tuhh.gitconfig
